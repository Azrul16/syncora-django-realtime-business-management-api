# Core
SECRET_KEY=change-me-to-a-long-random-secret
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Local-only auth bypass. Keep False outside local manual API testing.
DISABLE_AUTH_FOR_LOCAL_DEV=False
LOCAL_DEV_AUTH_EMAIL=

# PostgreSQL
DB_NAME=syncora
DB_USER=syncora_user
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=5432

# Logging
DJANGO_LOG_LEVEL=INFO
SYNCORA_REQUEST_LOG_LEVEL=INFO
SYNCORA_EVENT_LOG_LEVEL=INFO
SYNCORA_SECURITY_LOG_LEVEL=INFO

# Production security toggles
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
CSRF_TRUSTED_ORIGINS=
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False
X_FRAME_OPTIONS=DENY

# Email
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
